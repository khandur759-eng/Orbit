<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="6dp">

    <!-- The wheel is one bitmap; the 12 transparent hit zones sit on top of the
         ring icons and carry the per-app launch PendingIntents. -->
    <FrameLayout
        android:id="@+id/wheel_box"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_gravity="center">

        <ImageView
            android:id="@+id/wheel_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:contentDescription="@string/app_name" />

        <ImageView android:id="@+id/hit_0" style="@style/OrbitWidgetHit" />
        <ImageView android:id="@+id/hit_1" style="@style/OrbitWidgetHit" />
        <ImageView android:id="@+id/hit_2" style="@style/OrbitWidgetHit" />
        <ImageView android:id="@+id/hit_3" style="@style/OrbitWidgetHit" />
        <ImageView android:id="@+id/hit_4" style="@style/OrbitWidgetHit" />
        <ImageView android:id="@+id/hit_5" style="@style/OrbitWidgetHit" />
        <ImageView android:id="@+id/hit_6" style="@style/OrbitWidgetHit" />
        <ImageView android:id="@+id/hit_7" style="@style/OrbitWidgetHit" />
        <ImageView android:id="@+id/hit_8" style="@style/OrbitWidgetHit" />
        <ImageView android:id="@+id/hit_9" style="@style/OrbitWidgetHit" />
        <ImageView android:id="@+id/hit_10" style="@style/OrbitWidgetHit" />
        <ImageView android:id="@+id/hit_11" style="@style/OrbitWidgetHit" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/widget_pager"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp">

        <ImageButton
            android:id="@+id/widget_prev"
            style="@style/OrbitWidgetNav"
            android:layout_gravity="start|bottom"
            android:src="@drawable/ic_chevron_left"
            android:contentDescription="@string/widget_prev" />

        <ImageButton
            android:id="@+id/widget_next"
            style="@style/OrbitWidgetNav"
            android:layout_gravity="end|bottom"
            android:src="@drawable/ic_chevron_right"
            android:contentDescription="@string/widget_next" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_empty_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_empty_text"
            android:textColor="#A1A1AA"
            android:textSize="12sp"
            android:gravity="center" />

        <Button
            android:id="@+id/widget_edit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/edit_in_orbit" />
    </LinearLayout>
</FrameLayout>
